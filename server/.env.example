# Copy this file to .env (optional — defaults work fine for local development)

# Port to listen on. Render sets this automatically; do not set it there.
PORT=5000

# Comma-separated list of browser origins allowed to call the API (CORS).
# Exact match: scheme + host (+ port), no trailing slash, no path.
# Leave unset/empty to allow every origin (local development).
# Requests with no Origin header (health checks, curl) are always allowed.
# Production example:
#   ALLOWED_ORIGINS=https://synerguard.vercel.app
ALLOWED_ORIGINS=
