# Copy to client/.env for local overrides (client/.env is git-ignored).
#
# VITE_API_BASE_URL — base URL of the SynerGuard API, including the /api suffix
# and without a trailing slash. Read at BUILD time by Vite and baked into the
# bundle, so changing it requires a rebuild/redeploy.
#
# Leave unset in local development: the client falls back to /api, which
# vite.config.js proxies to http://localhost:5000.
#
# Production example (set this in the Vercel dashboard, not here):
#   VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api
VITE_API_BASE_URL=
